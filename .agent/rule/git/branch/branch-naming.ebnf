(* .agent/rule/git/branch/branch-naming.ebnf *)
(* ebnf subset version: 1 *)
(* format: two-space indent; rule name, =, expression, and ; use separate lines *)

(* ========================================================================== *)
(* TOP‑LEVEL: Branch name is either planned work or a community ticket        *)
(* ========================================================================== *)
git-branch-name
  = topic
  | ticket
  ;

(* PLANNED WORK: type / scope-desc *)
topic
  = type, "/", [ scope, "-" ], desc
  ;

type
  = "feature"
  | "hotfix"
  | "perf"
  ;

scope
  = identifier
  ;

desc
  = identifier, { "-", segment }
  ;

segment
  = identifier
  | number
  ;

(* COMMUNITY TICKET: issue or discussion / number *)
ticket
  = ("issue" | "discussion"), "/", number
  ;

number
  = ? regex:/[1-9][0-9]*/ ?
  ;

(* BASICS *)
identifier
  = ? regex:/[A-Za-z][A-Za-z0-9]*/ ?
  ;
